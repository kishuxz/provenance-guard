{
  "name": "@provguard/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "provguard": "./bin/provguard.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@provguard/harness": "workspace:*",
    "@provguard/inbound": "workspace:*",
    "@provguard/outbound": "workspace:*",
    "@provguard/schema": "workspace:*"
  }
}
